# The site for the Compose stack: the built SPA, and /api proxied to the api service.
# Plain HTTP on :80 — TLS, if any, is the host's front proxy's job.
{
	admin off
	auto_https off
}

:80 {
	root * /srv

	# Pictures, waiver scans and receipts are uploaded through /api.
	request_body /api/* {
		max_size 50MB
	}

	handle /api/* {
		# Live updates are Server-Sent Events (app/live.py): pass every event on at once.
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Which installation this is and what it runs, for the SPA (web/src/lib/environment.ts):
	# this container's SBL_ENVIRONMENT (staging sets it and gets a red top bar), SBL_VERSION
	# and SBL_COMMIT (deploy.sh writes them to .env), read when Caddy starts. At runtime,
	# so staging and production run the same image and each still names its own release.
	handle /environment.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		respond `window.sblEnvironment = "{$SBL_ENVIRONMENT}"; window.sblVersion = "{$SBL_VERSION}"; window.sblCommit = "{$SBL_COMMIT}";`
	}

	# Hashed bundle files never change under the same name.
	handle /assets/* {
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Every other path is a route of the SPA.
	handle {
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
