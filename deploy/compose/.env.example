# Copy to deploy/compose/.env — the settings that are not secret. Never commit .env.
# The secrets are in secrets.sops.env, encrypted, and reach compose through compose.sh
# (README.md, "Secrets"); only without sops are they set here instead.
# Every SBL_* setting of api/app/config.py is listed; the values shown are the stack's
# defaults (compose.yaml), so a line may be left out. SBL_DATABASE_URL and SBL_STORAGE
# are set by compose.yaml itself (Postgres, always S3) and are not read here, and
# SBL_S3_ACCESS_KEY_ID / SBL_S3_SECRET_ACCESS_KEY are S3_ACCESS_KEY / S3_SECRET_KEY below,
# shared with SeaweedFS.
# The tuned tracking constants (SBL_TRACKING_*, api/app/tracking/settings.py) are not
# passed through; add them to `x-api-env` in compose.yaml if one must change.

# ---------------------------------------------------------------- secrets
# Normally from secrets.sops.env via compose.sh, whose values win over this file. Without
# sops, uncomment and fill in; generate one with
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# POSTGRES_PASSWORD=
# SBL_JWT_SECRET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# SBL_SMTP_PASSWORD=
# SBL_BREVO_API_KEY=

# ---------------------------------------------------------------- ports and database
WEB_PORT=8080
S3_PORT=8333
POSTGRES_USER=sbl
POSTGRES_DB=sbl

# ---------------------------------------------------------------- uploads (S3)
# SeaweedFS in this stack by default. For an outside provider (AWS, Hetzner, Cloudflare R2,
# MinIO, ...): drop `seaweedfs` from COMPOSE_PROFILES, so the storage service is not
# started, and set the endpoint, region, bucket and the key pair above. The bucket is
# created on the first use if the key may; otherwise create it first. Moving the files from
# one provider to the other: README.md, "Uploads".
COMPOSE_PROFILES=seaweedfs
SBL_S3_ENDPOINT_URL=http://storage:8333
SBL_S3_REGION=us-east-1
SBL_S3_BUCKET=sbl-uploads
SBL_S3_PREFIX=
SBL_S3_CACHE_SECONDS=300
# "path" (host/bucket/key — SeaweedFS, MinIO, most providers) or "virtual" (bucket.host/key,
# what AWS prefers)
SBL_S3_ADDRESSING_STYLE=path

# ---------------------------------------------------------------- seed
# The first start seeds the real 2026 season plus two demo series of invented data (made-up
# sailors and weekends, the test accounts' acts), kept unpublished. true publishes them —
# a demonstration server only, never a real site.
SEED_PUBLISH_DEMO=false

# ---------------------------------------------------------------- API
SBL_DEBUG=false
# Same origin through Caddy, so CORS only matters for another origin calling the API.
SBL_CORS_ORIGINS=["http://localhost:8080"]
SBL_JWT_LIFETIME_MINUTES=720
SBL_PAIRING_TIMEOUT_SECONDS=1800

# DANGER: /api/dev issues access tokens WITHOUT verification, and the web image is built
# with the role switcher. Only for a stack nobody else can reach. Changing it needs a
# rebuild of the web image: docker compose ... up --build -d
SBL_DEV_LOGIN=false

# Identity providers — without an application ID the respective path is closed.
SBL_GOOGLE_CLIENT_ID=
SBL_MICROSOFT_CLIENT_ID=
SBL_MICROSOFT_TENANT=common

# One-time code by email
SBL_OTP_LENGTH=6
SBL_OTP_LIFETIME_MINUTES=10
SBL_OTP_MAX_ATTEMPTS=5

SBL_ALLOW_SELF_SIGNUP=false
SBL_ALLOW_REGISTRATION=true
SBL_ALLOW_PASSWORD_LOGIN=true
# Addresses that become site admin on their first sign-in, as a JSON list.
SBL_ADMIN_EMAILS=[]

# Mail. Without SMTP (or Brevo) the login code goes to the api log.
SBL_SMTP_HOST=
SBL_SMTP_PORT=587
SBL_SMTP_USER=
SBL_SMTP_STARTTLS=true
SBL_SMTP_SSL=false
SBL_MAIL_FROM=noreply@deutsche-segelliga.de
