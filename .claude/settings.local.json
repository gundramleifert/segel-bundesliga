{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "Bash(timeout 30 curl -s https://api.github.com/repos/gundramleifert/PairingList/releases)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:codeload.github.com)",
      "Bash(timeout 25 git fetch --dry-run origin)",
      "Bash(echo \"exit=$?\")",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git -c core.quotepath=off commit -q -F -)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": true
  }
}
