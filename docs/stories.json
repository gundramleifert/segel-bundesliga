  "path": "club uploads",
  "who": "team manager",
  "what": "the same, recorded by the team manager for a form the club collected"
 },
 "J-5.14": {
  "journey": "J-5",
  "story": "VA-5",
  "path": "main",
  "who": "event organizer",
  "what": "the check-in list shows every squad member `cleared`, nothing outstanding, the minors' scans on file"
 },
 "J-5.15": {
  "journey": "J-5",
  "story": "V-13",
  "path": "guardian online",
  "who": "team manager",
  "what": "the parent holds `guardian` on the sailor — only the child's club may link"
 },
 "J-5.16": {
  "journey": "J-5",
  "story": "S-8",
  "path": "guardian online",
  "who": "guardian",
  "what": "a `guardian_online` confirmation from the parent's own account; the minor is cleared, nothing on paper"
 },
 "J-5.17": {
  "journey": "J-5",
  "story": "VA-5",
  "path": "main",
  "who": "site",
  "what": "the club's card in the manager's my space shows `crew_waiver_missing` — the crew stays named, nothing is locked"
 },
 "J-5.2": {
  "journey": "J-5",
  "story": "V-1",
  "path": "squad too small",
  "who": "site",
  "what": "below the series' minimum: the squad says `squad_min`, my space shows `squad_below_min` — and it is saved"
 },
 "J-5.3": {
  "journey": "J-5",
  "story": "V-1",
  "path": "squad too small",
  "who": "team manager",
  "what": "the squad reaches the minimum; the need is gone"
 },
 "J-5.4": {
  "journey": "J-5",
  "story": "V-12",
  "path": "stand-alone event",
  "who": "team manager",
  "what": "the squad is saved on the event entry, within the event's own limits"
 },
 "J-5.5": {
  "journey": "J-5",
  "story": "V-2",
  "path": "main",
  "who": "team manager",
  "what": "the crew is named for the matchday — only from the squad"
 },
 "J-5.6": {
  "journey": "J-5",
  "story": "Z-8",
  "path": "main",
  "who": "site",
  "what": "each sailor's my space shows `waiver` on the series (or the stand-alone event)"
 },
 "J-5.7": {
  "journey": "J-5",
  "story": "S-2",
  "path": "no date of birth",
  "who": "sailor",
  "what": "the age can be judged; until then the page says \"add your date of birth first\" and confirming is refused (`waiver-birth-date-required`)"
 },
 "J-5.8": {
  "journey": "J-5",
  "story": "S-1",
  "path": "adult",
  "who": "sailor",
  "what": "an `online` confirmation of the version in force; the sailor is cleared for every event of the series"
 },
 "J-5.9": {
  "journey": "J-5",
  "story": "S-1",
  "path": "on paper",
  "who": "sailor",
  "what": "the form PDF with the wording, name, date of birth and competition; an online click is refused (`guardian-confirmation-needed`)"
 },
