# Non-secret configuration for the Render test deployment, baked into the Docker image
# (see the Dockerfile) instead of depending on Render's dashboard Environment Variables —
# those have proven unreliable to actually apply to this pre-existing service (empty
# values, sync: false slots never created; see docs/deploy.md). pydantic-settings reads
# this the same way it reads a local .env (SettingsConfigDict(env_file=".env") in
# app/config.py) once the Dockerfile copies it in as .env.
#
# To change one of these: edit this file and push — a normal code change, no dashboard
# step, no Blueprint sync. Real secrets (SBL_JWT_SECRET, SBL_SMTP_PASSWORD) do NOT belong
# here — they stay out of git entirely, via Render Secret Files (/etc/secrets/<name>,
# see _SECRETS_DIR in app/config.py).

SBL_DEV_LOGIN=true
SBL_ALLOW_REGISTRATION=true
SBL_CORS_ORIGINS=["https://sbl-web.onrender.com"]

SBL_SMTP_HOST=smtp.strato.de
SBL_SMTP_PORT=465
SBL_SMTP_SSL=true
SBL_SMTP_STARTTLS=true
SBL_SMTP_USER=web@deutsche-segelliga.de
SBL_MAIL_FROM=web@deutsche-segelliga.de
