# Kopieren nach api/.env und anpassen.

# Datenbank (Produktion und Entwicklung: Postgres)
SBL_DATABASE_URL=postgresql+asyncpg://sbl:sbl@localhost:5432/sbl

# Signatur der Sitzungstoken. Ohne diesen Wert ist der geschützte Bereich zu.
# Erzeugen mit: python -c "import secrets; print(secrets.token_urlsafe(48))"
SBL_JWT_SECRET=

# Identitätsanbieter — ohne Anwendungskennung ist der jeweilige Weg zu.
SBL_GOOGLE_CLIENT_ID=
SBL_MICROSOFT_CLIENT_ID=
SBL_MICROSOFT_TENANT=common

# Ohne SMTP landet der Anmeldecode im Log (nur für die Entwicklung gedacht).
SBL_SMTP_HOST=
SBL_SMTP_PORT=587
SBL_SMTP_USER=
SBL_SMTP_PASSWORD=
SBL_MAIL_FROM=noreply@segelbundesliga.de

# Pairing-Generator: JAR aus reference/PairingList, gebaut mit "mvn -DskipTests package"
SBL_PAIRING_JAR=../reference/PairingList/target/pairing-list-1.0-SNAPSHOT-jar-with-dependencies.jar
