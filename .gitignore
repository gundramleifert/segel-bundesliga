# --- Personal / machine-local files that live in this working tree but are NOT the project ---
# (the sandbox masks several of these as /dev/null; patterns have no trailing slash so
#  they match whatever type they appear as)
.bashrc
.bash_profile
.profile
.zshrc
.zprofile
.ripgreprc
.gitconfig
.gitmodules
.idea
.vscode
#x.claude
.mcp.json

# --- Reference repos: shallow clones for lookup only, deliberately not versioned ---
/reference/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# The development database (SQLite) plus WAL files — regenerate any time with
# `uv run python -m app.seed_test_setup --reset`.
*.db
*.db-shm
*.db-wal
.uv-cache/

# Secrets: real env files are never committed; .env.example is the template that is.
.env
.env.local
.env.*.local

# Runtime-uploaded files (sailor photos, …) — not source, regenerated by users at any time.
api/uploads/

# --- Node ---
node_modules/
dist/
.vite/

# --- Playwright ---
playwright-report/
test-results/
/test-results/
/playwright-report/

# Stale artifacts — not part of the project
*.bak
*.db.bak
# Scraped reference copies of the live WordPress site (logos/colours were taken from here);
# reference material, not shipped, not referenced by any source.
web/sbl.html
web/sbl.css

# Build input for the generated API client (scripts/gen-api-client.sh writes it).
web/openapi.json
api/e2e-*.db

# Claude Code's local state.
#
# Two reasons, and the second is the one that bites: `.claude/worktrees/` holds a full
# copy of this repository per agent run (418 MB across 36,000 files when this was
# written), and most of the rest is **denied to the agent sandbox**, which presents a
# denied path as an empty file — `git add .claude` stages `hooks`, `skills`, `agents`
# and `settings.json` as 0-byte blobs, and a checkout elsewhere would then write
# nothing over someone's real configuration. What is readable is kept: the command
# definitions, and the local settings file.
.claude/*
!.claude/commands/
!.claude/settings.local.json
api/.claude/
